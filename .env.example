# Copy to .env only on your machine. Never commit .env or put a real key here.
# This package does not load .env by itself. Export the variables, or start
# Node with --env-file=.env, before running the CLI or MCP server.

# Azure Speech resource key. Required.
SPEECH_KEY=

# Azure Speech resource region, for example westus. Required.
SPEECH_REGION=

# Optional. Leave unset for a normal regional resource.
# https://<region>.api.cognitive.microsoft.com/ is the portal API host, not the
# recognition websocket. If you set SPEECH_ENDPOINT to that host for the same
# region as SPEECH_REGION, the client uses SpeechConfig.fromSubscription and
# connects to wss://<region>.stt.speech.microsoft.com/stt/speech/universal/v2.
# Set SPEECH_ENDPOINT only for a private link or another non-portal speech endpoint.
# SPEECH_ENDPOINT=

# Speechace text-scoring key. Required only for --provider speechace.
# Sent as the key query parameter. Never printed.
SPEECHACE_API_KEY=

# Test seam. When set, Azure is not called and the result is marked synthetic.
# Never set this for a real assessment. pronunciation-assess-smoke refuses it.
# PA_SYNTHETIC_RESPONSE_FILE=

# Speechace test seam. When set, --provider speechace reads this JSON file
# instead of calling Speechace and marks the result synthetic.
# PA_SPEECHACE_RESPONSE_FILE=
